{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "es6",
    "target": "es2024",
    "jsx": "react",
    // If you are using React
    "allowJs": true,
    "moduleResolution": "node",
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // If you are using React,
    "src/renderer/js/Classes/SlideManager",
    "src/renderer/ShowCreateView/js/fileOpen.js"
  ],
  "exclude": [
    "src/obsoverlay"
  ]
}